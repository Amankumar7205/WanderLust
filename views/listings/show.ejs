<% layout("layout/biolerplate")%>
<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3><%=listing.title %></h3>
    </div>
<div class="card col-6 offset-2 listing-card">
  <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="listing_image">
  <div class="card-body">
        <p class="card-text">
            <p><i> owned by <%=listing.owner.username%> </i></p>
            <%=listing.description %>
            <br>
            &#8377;<%=listing.price.toLocaleString("en-IN") %>
            <br>
            <%=listing.location %>
            <br>
             <%=listing.country %>
        </p>
  </div>
</div>
<% if(curruser&& curruser._id.equals(listing.owner._id)){%>
<div class="btns">
     <a href="/listing/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-2 edit-btn ">Edit</a>
    <form method="post" action="/listing/<%=listing._id%>?_method=DELETE">
        <button calass="btn btn-dark ">Delete</button>
    </form>
</div>
<% } %>
<div class="col-8 offset-3 mb-3">
    <hr>
    <%if(curruser) {%>
    <h4> Leave a Review</h4>
    <form action="/listing/<%=listing._id %>/review" method="post" novalidate class="needs-validation">
        <div class="mb-3 mt-3">
            <label for="rating" class="form-label">Rating</label>
            <input type="range" min="1" max="5" name="review[rating]" class="form-range" id="rating">  
        </div>
        <div class="mb-3 mt-3">
            <label for="comment" class="form-label">Comment</label>
            <textarea 
            minlength="5"
            name="review[comment]"
            id="comment"
            col="30"
            rows="5"
            class="form-control"
            required> </textarea>
            <div class="invalid-feedback">Please add some comment for review</div>
        </div>
        <br>

        <button class="btn btn-outline-dark" type="submit" >Submit</button>

    </form>

    <hr>
    <%}%>
    <% if(listing.reviews.length>0){%>
    <div class="row">
        <h4> ALL Review</h4>
    <%  for(review of listing.reviews) {%>
        <div class="card col-5 ms-3 mb-3">
            <div class="card-body">
                <h5 class="card-title">@<%=review.author.username%></h5>
                 <p class="card-text"><%=review.comment %></p>
                  <p class="card-text"><%=review.rating %> star</p>

            </div>
            <%if(curruser&& curruser._id.equals(review.author._id)) {%>
            <form class="mb-3" action="/listing/<%=listing._id %>/review/<%= review._id %>?_method=DELETE" method="post">
                <button class="btn btn-sm btn-dark">Delete</button>
            </form>
            <% }%>
        </div>
    <%}%>
    </div>
    <%}%>
    <div class="col-6 offset-3 mb-3">
        <h3>Where you'll be</h3>
        <div id="map"></div>
    </div>
</div>
</div>
<script >
    let mapToken="<%=process.env.MAP_TOKEN %>";
    let coordinates=<%- JSON.stringify(listing.geometry.coordinates)%>;
   console.log(mapToken)
    mapboxgl.accessToken = mapToken;
    const map = new mapboxgl.Map({
        container: 'map', // container ID
        center: coordinates, // starting position [lng, lat]. Note that lat must be set between -90 and 90
        zoom: 9 // starting zoom
    });
    const marker= new mapboxgl.Marker({color:"red"})
        .setLngLat(coordinates)
        .setPopup( new mapboxgl.Popup({offset: 25,})
    .setHTML("<p>Exact Location provided after booking!</p>"))
        .addTo(map);
</script>
    
