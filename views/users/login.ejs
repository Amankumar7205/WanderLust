<% layout("layout/biolerplate")%>
<div class="row mt-3">
    <h1 class="col-6 offset-3" > Login</h1>
        <div class="col-8 offset-2">
            <form action="/login" class="needs-validation" novalidate method="post">
            <div class="mb-3">
            <label for="username" class="form-label">username</label>
             <input name="username" placeholder=" enter username" type="text" class="form-control" required>
        </div>
        <div class="mb-3">
            <label for="password" class="form-label">password</label>
             <input name="password" placeholder=" enter password" type="password" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-success">login</button>
            </form>
        </div>
    </div>